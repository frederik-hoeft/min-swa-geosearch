root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 200

[*.cs]
charset = utf-8-bom
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_preferred_modifier_order = public,private,internal,protected,file,static,extern,const,required,sealed,virtual,new,async,abstract,override,readonly,unsafe,volatile:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_braces = false
csharp_indent_block_contents = true
csharp_indent_switch_labels = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false

[*.{json,yaml,yml}]
indent_size = 2

[*.{props,targets,csproj,slnx}]
indent_size = 2
