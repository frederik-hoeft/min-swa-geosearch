<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <SassCompilerEnableWatcher>false</SassCompilerEnableWatcher>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="AspNetCore.SassCompiler" Version="1.103.0" PrivateAssets="all" Condition="'$(GeoSearchEnableSassCompiler)' != 'false'" />
    <PackageReference Include="MudBlazor" Version="9.9.0" />
    <PackageReference Include="Community.Blazor.MapLibre" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../GeoSearch.Web.Shared/GeoSearch.Web.Shared.csproj" />
  </ItemGroup>
</Project>
