@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@implements IDisposable
@inject AuthenticationService Authentication
@inject NavigationManager Navigation
@inject SessionAuthenticationStateProvider AuthenticationState

<PageTitle>Sign in | GeoSearch</PageTitle>
<div class="gs-auth-card">
    <div class="gs-auth-eyebrow">SECURE ACCESS</div>
    <h1>Welcome back</h1>
    <p class="gs-auth-description">Sign in to your GeoSearch workspace.</p>
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="gs-auth-error" role="alert">@_error</MudAlert>
    }
    <MudForm @ref="_form" OnEnterPressed="SignInAsync" aria-busy="@_busy">
        <MudTextField T="string" Label="Email address" InputType="InputType.Email" InputMode="InputMode.email"
                      @bind-Value="_email" Validation="@EmailValidation" Required="true" RequiredError="Enter your email address."
                      autocomplete="username" autocapitalize="off" spellcheck="false" Disabled="_busy"
                      Variant="Variant.Outlined" Margin="Margin.Normal" />
        <MudTextField T="string" Label="Password" InputType="InputType.Password"
                      @bind-Value="_password" Required="true" RequiredError="Enter your password."
                      autocomplete="current-password" Disabled="_busy"
                      Variant="Variant.Outlined" Margin="Margin.Normal" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" FullWidth="true"
                   OnClick="SignInAsync" Class="gs-auth-submit">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            @(_busy ? "Signing in..." : "Sign in")
        </MudButton>
    </MudForm>
    <p class="gs-auth-footnote">Accounts are provisioned by your GeoSearch administrator.</p>
</div>
