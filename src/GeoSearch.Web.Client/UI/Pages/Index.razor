@page "/"

<PageTitle>Home | GeoSearch</PageTitle>

<section class="gs-landing-page">
    <div class="gs-landing-hero">
        <div class="gs-hero-content">
            <div class="gs-hero-overline">GEOSPATIAL EXPLORATION / OPEN DATA</div>
            <h1>Open data. <em>Real places.</em></h1>
            <p>Explore Lower Saxony through OpenStreetMap. Navigate the region now, with address search and nearby discovery joining the workspace in the next phases.</p>
            <MudButton Href="/map" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Map" Size="Size.Large" Class="gs-hero-action">Explore the map</MudButton>
            <div class="gs-hero-technologies" aria-label="Powered by open geospatial technologies">
                <span>OpenStreetMap</span>
                <span>PostGIS</span>
                <span>MapLibre</span>
            </div>
        </div>
        <div class="gs-hero-cartography" aria-hidden="true">
            <div class="gs-hero-contours"></div>
            <div class="gs-hero-location">
                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Large" />
                <span>HANNOVER</span>
            </div>
            <div class="gs-hero-coordinate">52.3759° N / 9.7320° E</div>
        </div>
    </div>

    <div class="gs-landing-features" aria-label="GeoSearch capabilities">
        <article>
            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Medium" />
            <h2>Explore</h2>
            <p>Navigate an interactive, OpenStreetMap-based map of the region.</p>
        </article>
        <article>
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Medium" />
            <h2>Search</h2>
            <p>Place and address lookup is coming to the map workspace.</p>
        </article>
        <article>
            <MudIcon Icon="@Icons.Material.Filled.NearMe" Size="Size.Medium" />
            <h2>Nearby</h2>
            <p>Category and radius-based discovery is planned for a later phase.</p>
        </article>
    </div>
</section>
