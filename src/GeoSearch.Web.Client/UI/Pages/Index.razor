@page "/"
@attribute [Authorize]
@inject AuthenticationService Authentication
@inject AuthApiClient AuthApi
@inject SessionAuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation

<PageTitle>Map and search | GeoSearch</PageTitle>
<MudText Typo="Typo.h4" Class="mb-2">Map and search</MudText>
<MudText Typo="Typo.body1">GeoSearch is ready for the geospatial search implementation.</MudText>
<MudPaper Outlined="true" Class="pa-6 mt-5 map-placeholder">
    <MudText Typo="Typo.h6">Map will appear here</MudText>
    <MudText Typo="Typo.body2">
        MapLibre layers, local GeoJSON results, nearby queries, and browser geolocation will be implemented in the next phase.
    </MudText>
</MudPaper>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            string? token = await Authentication.GetAccessTokenAsync();
            if (token is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            AccountResponse? account = await AuthApi.GetAccountAsync(token);
            if (account is null)
            {
                string? refreshed = await Authentication.RefreshAfterUnauthorizedAsync(token);
                if (refreshed is not null)
                {
                    account = await AuthApi.GetAccountAsync(refreshed);
                }
            }

            if (account is null)
            {
                AuthenticationState.Logout();
                Navigation.NavigateTo("/login");
            }
        }
        catch (HttpRequestException)
        {
            // Report connectivity problems without pretending the server revoked the session.
        }
    }
}
