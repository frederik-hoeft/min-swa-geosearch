@page "/"

<PageTitle>Home | GeoSearch</PageTitle>

<section class="gs-landing-page">
    <div class="gs-landing-hero">
        <div class="gs-page-kicker">GEOSPATIAL EXPLORATION</div>
        <h1>Discover places on the map.</h1>
        <p>Explore OpenStreetMap data from Niedersachsen. Search for places and addresses, inspect locations, and find nearby points of interest as the workspace evolves.</p>
        <MudButton Href="/map" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Map" Size="Size.Large">Open the map</MudButton>
    </div>

    <div class="gs-landing-features" aria-label="GeoSearch capabilities">
        <article>
            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Medium" />
            <h2>Explore</h2>
            <p>Navigate an interactive, OpenStreetMap-based map of the region.</p>
        </article>
        <article>
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Medium" />
            <h2>Search</h2>
            <p>Place and address lookup is coming to the map workspace.</p>
        </article>
        <article>
            <MudIcon Icon="@Icons.Material.Filled.NearMe" Size="Size.Medium" />
            <h2>Nearby</h2>
            <p>Category and radius-based discovery is planned for a later phase.</p>
        </article>
    </div>
</section>
