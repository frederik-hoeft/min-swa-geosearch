@page "/password"
@attribute [Authorize]
@inject AuthenticationService Authentication
@inject NavigationManager Navigation

<PageTitle>Change password | GeoSearch</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudPaper Class="pa-6" Elevation="1">
        <MudText Typo="Typo.h5" GutterBottom="true">Change password</MudText>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
        }
        <MudTextField T="string" Label="Current password" @bind-Value="_currentPassword"
                      InputType="InputType.Password" Disabled="_busy" Class="mb-3" />
        <MudTextField T="string" Label="New password" @bind-Value="_newPassword"
                      InputType="InputType.Password" Disabled="_busy" Class="mb-3" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                   OnClick="ChangeAsync">Update password</MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task ChangeAsync()
    {
        if (_busy)
        {
            return;
        }

        _error = null;
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = "Enter your current and new passwords.";
            return;
        }

        _busy = true;
        try
        {
            bool changed = await Authentication.ChangePasswordAsync(_currentPassword, _newPassword);
            if (changed)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                _error = "Password change rejected. Check your current password and password requirements.";
            }
        }
        catch (HttpRequestException)
        {
            _error = "The authentication service is unavailable.";
        }
        finally
        {
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _busy = false;
        }
    }
}
