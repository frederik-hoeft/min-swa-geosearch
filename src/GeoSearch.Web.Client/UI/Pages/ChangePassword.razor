@page "/password"
@attribute [Authorize]
@implements IDisposable
@inject AuthenticationService Authentication
@inject NavigationManager Navigation

<PageTitle>Change password | GeoSearch</PageTitle>
<section class="gs-settings-page">
    <div class="gs-page-heading">
        <MudButton Href="/" StartIcon="@Icons.Material.Filled.ArrowBack" Variant="Variant.Text" Color="Color.Secondary" Class="gs-back-link">Back to map</MudButton>
        <div class="gs-page-kicker">ACCOUNT / SECURITY</div>
        <h1>Change password</h1>
        <p>Update your credentials. Other refresh sessions will be revoked.</p>
    </div>
    <MudPaper Class="gs-settings-card" Elevation="0">
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4" role="alert">@_error</MudAlert>
        }
        <MudForm @ref="_form" OnEnterPressed="ChangeAsync" aria-busy="@_busy">
            <MudTextField T="string" Label="Current password" @bind-Value="_currentPassword"
                          InputType="InputType.Password" Required="true" RequiredError="Enter your current password."
                          autocomplete="current-password" Disabled="_busy" Variant="Variant.Outlined" Margin="Margin.Normal" />
            <MudTextField T="string" Label="New password" @bind-Value="_newPassword"
                          InputType="InputType.Password" Required="true" RequiredError="Enter a new password."
                          autocomplete="new-password" Disabled="_busy" Variant="Variant.Outlined" Margin="Margin.Normal" />
            <div class="gs-settings-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="ChangeAsync">
                    @(_busy ? "Saving..." : "Update password")
                </MudButton>
            </div>
        </MudForm>
    </MudPaper>
</section>
