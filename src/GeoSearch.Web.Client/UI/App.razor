@using GeoSearch.Web.Client.Services.Theming

<MudThemeProvider Theme="@GeoSearchMudTheme.Theme" IsDarkMode="false" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@inject AuthenticationService Authentication

@if (!_initialized)
{
    <main class="startup-shell" role="status">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
        <p>Restoring your session...</p>
    </main>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p>Checking authentication...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Page not found.</p>
            </LayoutView>
        </NotFound>
    </Router>
}
