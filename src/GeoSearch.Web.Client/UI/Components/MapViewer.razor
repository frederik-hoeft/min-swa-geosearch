@using Community.Blazor.MapLibre

<div class="gs-map-viewer" role="region" aria-label="Interactive OpenStreetMap map">
    @if (_startupError is not null)
    {
        <div class="gs-map-notice gs-map-notice--error" role="alert">
            @_startupError
            <button type="button" @onclick="Reload">Reload</button>
        </div>
    }
    else if (!_styleChecked || !_browserChecked)
    {
        <div class="gs-map-notice" role="status">Preparing the map...</div>
    }
    else if (!_supportsWebGl2)
    {
        <div class="gs-map-notice gs-map-notice--error" role="alert">
            This browser or device does not support WebGL2, which MapLibre requires to display the map.
        </div>
    }
    else
    {
        <ErrorBoundary>
            <ChildContent>
                <MapLibre @ref="_map" Options="_options" Height="100%" Width="100%"
                          OnLoad="OnMapLoadedAsync" />
                @if (!_mapLoaded && !_mapLoadTimedOut)
                {
                    <div class="gs-map-loading" role="status">Loading map tiles...</div>
                }
                @if (_hasOverlayError)
                {
                    <div class="gs-map-tile-error" role="alert">Map results could not be displayed. Search results are still available in the panel.</div>
                }
                @if (_mapLoadTimedOut)
                {
                    <div class="gs-map-tile-error" role="alert">
                        The map did not finish loading. Check the map style, tile provider, and network connection.
                        <button type="button" @onclick="Reload">Reload</button>
                    </div>
                }
            </ChildContent>
            <ErrorContent>
                <div class="gs-map-notice gs-map-notice--error" role="alert">
                    The map could not start. Check your browser settings and reload the page.
                </div>
            </ErrorContent>
        </ErrorBoundary>
    }
    <a class="gs-map-report-link" href="https://www.openstreetmap.org/fixthemap"
       target="_blank" rel="noopener noreferrer">Report a map issue</a>
</div>
