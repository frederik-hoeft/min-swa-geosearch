<MudIconButton Icon="@(ThemePreferences.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
               Color="Color.Inherit" Size="Size.Medium" Class="gs-theme-toggle"
               aria-label="@(ThemePreferences.IsDarkMode ? "Switch to light theme" : "Switch to dark theme")"
               title="@(ThemePreferences.IsDarkMode ? "Switch to light theme" : "Switch to dark theme")"
               OnClick="ToggleAsync" />
