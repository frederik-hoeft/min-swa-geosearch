{
  "openapi": "3.0.4",
  "info": {
    "title": "GeoSearch.Web.Server",
    "version": "1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "GeoSearch.Web.Server"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Searches addresses, places and POIs using the PostgreSQL search function.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Free-text query (1-200 characters). \nStreet, house number and town are entered as a single string.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (1-20). Default: 10.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching search results as a GeoJSON feature collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeatureCollection"
                }
              }
            }
          },
          "400": {
            "description": "The query text or limit is outside the accepted range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reverse": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Finds the nearest address, POI or street around a geographic position.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude in WGS84 (-90 to 90).",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Longitude in WGS84 (-180 to 180).",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "description": "Search radius in metres (> 0 and <= 1000). Default: 250.",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The nearest matching object as a GeoJSON feature collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeatureCollection"
                }
              }
            }
          },
          "400": {
            "description": "Coordinates or radius are outside the accepted range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/nearby": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Returns nearby POIs ordered by distance.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude in WGS84 (-90 to 90).",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Longitude in WGS84 (-180 to 180).",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "description": "Search radius in metres (> 0 and <= 2000). Default: 500.",
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Optional POI category filter. Maximum length: 200 characters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (1-20). Default: 20.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching nearby POIs as a GeoJSON feature collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoJsonFeatureCollection"
                }
              }
            }
          },
          "400": {
            "description": "Coordinates, radius, category or limit are outside the accepted range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Returns the available POI categories for nearby searches.",
        "responses": {
          "200": {
            "description": "List of available category labels.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GeoJsonFeature": {
        "type": "object",
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/GeoJsonPoint"
          },
          "properties": {
            "$ref": "#/components/schemas/GeoJsonProperties"
          },
          "type": {
            "type": "string",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "GeoJsonFeatureCollection": {
        "type": "object",
        "properties": {
          "snapshot": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GeoJsonFeature"
            }
          },
          "type": {
            "type": "string",
            "readOnly": true
          },
          "attribution": {
            "type": "string",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "GeoJsonPoint": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "readOnly": true
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "GeoJsonProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "distance_m": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "GeoSearch.Web.Server"
    },
    {
      "name": "Search"
    }
  ]
}