# Copy to deploy/.env (git-ignored) and replace both example passwords.
# Use long random alphanumeric values; Compose interpolates these into settings.
POSTGIS_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_ADMIN_PASSWORD
GEOSEARCH_READER_PASSWORD=REPLACE_WITH_RANDOM_READ_ONLY_PASSWORD

# Local host ports, never published on non-loopback interfaces by default.
GEOSEARCH_HTTPS_BIND_ADDRESS=127.0.0.1
GEOSEARCH_HTTP_PORT=8080
GEOSEARCH_HTTPS_PORT=8443

# For host bind-mounted GIS data (defaults work for many Linux/WSL users).
GEOSEARCH_DATA_UID=1000
GEOSEARCH_DATA_GID=1000

# API runs with Production behavior unless explicitly changed for local debugging.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_BUILD_CONFIGURATION=Release
