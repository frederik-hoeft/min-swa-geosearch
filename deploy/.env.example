# Copy to deploy/.env and replace both passwords. This file stays Git-ignored.
POSTGIS_PASSWORD=
GEOSEARCH_READER_PASSWORD=

# TLS is required. Default binding is loopback-only.
GEOSEARCH_HTTPS_BIND_ADDRESS=127.0.0.1
GEOSEARCH_HTTPS_PORT=8443

# Only the deployed API uses this setting. The devcontainer exports
# ASPNETCORE_ENVIRONMENT=Development, which takes precedence during Compose
# interpolation if the same key is reused here.
# Swagger is available only when GEOSEARCH_API_ENVIRONMENT=Development.
GEOSEARCH_API_ENVIRONMENT=Production
DOTNET_BUILD_CONFIGURATION=Release
